# Solo local: npm start. Con SQLite el acceso inicial es admin/admin y solo se acepta en este computador.
PORT=4173
SEO_DB_PATH=.local/seobestia.sqlite

# En Netlify configurar estos valores como secretos de ejecución.
# DATABASE_URL corresponde a PostgreSQL Neon con TLS. Vacío utiliza SQLite local.
DATABASE_URL=
SEO_ADMIN_EMAIL=
SEO_ADMIN_PASSWORD=
SEO_ADMIN_NAME=Administrador
SEO_WORKER_TOKEN=
# Solo alojamiento con PostgreSQL. Secreto privado para permitir la carga de Google desde la web.
# 32 bytes aleatorios independientes en base64 o 64 dígitos hexadecimales. Mismo valor en API y trabajador.
SEO_GOOGLE_VAULT_KEY=
# JSON de cuenta de servicio Google codificado en base64, solo lectura.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Analytics usa el mismo acceso si se concedieron permisos sobre la propiedad GA4.
# Configura esta variable para usar una cuenta de servicio de lectura independiente.
GA4_SERVICE_ACCOUNT_JSON_BASE64=

# Opcional. Nombre de un modelo ya instalado en Ollama en este equipo.
# El analizador estadístico ya está activo. Ollama en localhost puede ordenar los hallazgos.
SEO_OLLAMA_MODEL=

# Respaldo en Neon Object Storage. Usar bucket privado y guardar la clave fuera del proyecto.
SEO_BACKUP_KEY=
SEO_S3_ENDPOINT=
SEO_S3_BUCKET=
SEO_S3_ACCESS_KEY_ID=
SEO_S3_SECRET_ACCESS_KEY=
SEO_S3_REGION=us-east-1

